<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eel_black">

    <com.deku.autovnc.ui.VncView
        android:id="@+id/vncView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top floating status pill -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/chip_duo_pill"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/owl_green_deep"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Duolingo Style Control Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/snow"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Disconnect (Cardinal Red 3D Button) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDisconnect"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_cardinal_red"
            android:fontFamily="sans-serif-black"
            android:text="✕"
            android:textColor="@color/snow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Mouse Mode (Eel Blue 3D Button) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMouseMode"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_eel_blue"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="12dp"
            android:text="Sol Tık"
            android:textAllCaps="false"
            android:textColor="@color/snow"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Ctrl+Alt+Del (Streak Orange 3D Button) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCtrlAltDel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_streak_orange"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="12dp"
            android:text="CAD"
            android:textAllCaps="false"
            android:textColor="@color/snow"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Toggle Car Controls (Owl Green 3D Button) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCarControls"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_owl_green"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="12dp"
            android:text="🚗 Tuşlar"
            android:textAllCaps="false"
            android:textColor="@color/snow"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Refresh (White 3D Button) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_secondary_white"
            android:fontFamily="sans-serif-black"
            android:text="🔄"
            android:textColor="@color/eel_black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Keyboard input (White 3D Button) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnKeyboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_secondary_white"
            android:fontFamily="sans-serif-black"
            android:text="⌨"
            android:textColor="@color/eel_black"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
